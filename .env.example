DEBUG=True
USE_SQLITE=True
ALLOWED_HOSTS=*
DJANGO_SECRET_KEY=dev-secret-key-change-me
# Independent client-user JWT signing secret; set a strong random value in deployment.
CLIENT_JWT_SIGNING_KEY=replace-with-long-random-independent-client-signing-secret
MYSQL_DATABASE=gateway_db
MYSQL_USER=gateway
MYSQL_PASSWORD=gateway
MYSQL_HOST=db
MYSQL_PORT=3306
# Docker Compose automatically enables Redis Cluster and uses redis-node-1 as a seed.
# These are defaults for running Django outside Compose.
REDIS_CLUSTER_ENABLED=False
REDIS_CLUSTER_URL=redis://redis-node-1:6379
# For standalone local development/tests only (without Docker Compose):
REDIS_URL=redis://127.0.0.1:6379/0
# Optional: replace the built-in Docker backend origins with a comma-separated list.
# GATEWAY_ALLOWED_BACKEND_ORIGINS=http://fashion-product-service:8000,http://127.0.0.1:9002
# Optional cache opt-in for non-sensitive backends only. JWT routes always bypass.
# GATEWAY_CACHEABLE_BACKEND_HOSTS=fashion-user-service,fashion-product-service,fashion-order-service
